# Havoc Teamserver Dockerfile
# ------------------------------------------------------------------------------
# Commands for usage:
#
#	Build image file (from the repository root, so local source is the context):
#		'docker build -t havoc-teamserver -f teamserver/Teamserver-Dockerfile .'
#	(Optional) Create Data volume for persistence:
#		`docker volume create <volume_name>`
#	Run Built Image file(`-d` for persistence):
#		'docker run -ti -d -v havoc-teamserver-data:/data havoc-teamserver'
#	Copy built Teamserver from container:
#		'docker cp <containerID>:/Havoc/havoc /host/path/target'
#
#	Run Built Teamserver from Docker container:
#		`docker run -p40056:40056 -p 443:443 -it -d -v havoc-c2-data:/data havoc-teamserver`
#
# Extras
# 	Create Data storage for persistence
#       'docker volume create havoc-teamserver-data'
# 	Enter Container:
#		'docker run exec -it <containerID> bash'
# ------------------------------------------------------------------------------
# Go 1.21+ required per teamserver/go.mod
ARG GO_VERSION="1.21"
FROM golang:${GO_VERSION}
#
ENV PATH=/root/.local/bin:$PATH
ENV USER=root
#
RUN apt update \
	&& apt -y install \
	alien \
	debhelper \
	devscripts \
	nasm \
	mingw-w64 \
	dh-golang \
	dh-make \
	fakeroot \
	pkg-config \
	python3-all-dev \
	python3-pip \
	rpm \
	sudo \
	libcap2-bin \
	upx-ucl \
	&& pip install --upgrade jsonschema --break-system-packages || pip install --upgrade jsonschema
#
# Build this fork's local source instead of cloning abandoned upstream
COPY . /Havoc
#
WORKDIR /Havoc
# Run Install.sh directly (no sudo password prompt in container) instead of the
# makefile ts-build target, which needs sudo for setcap
RUN cd teamserver/ && chmod +x ./Install.sh && ./Install.sh \
	&& cd .. && make dev-ts-compile
